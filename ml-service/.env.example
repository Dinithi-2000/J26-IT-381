PORT=8000
MODEL_PATH=../server/ml/cinnamon_price_xgb_model.pkl
COLUMNS_PATH=../server/ml/model_columns.pkl
MODEL_VERSION=xgb-v1

# Model 02 uses this service's isolated scikit-learn 1.6.1 environment.
# Relative risk paths resolve against ml-service, not the shell working directory.
RISK_MODEL_PATH=models/cinnasense_model02_demo.joblib
