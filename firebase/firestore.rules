rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /samples/{sampleId} {
      // Users can only read, create, and update their own samples
      allow read, create, update: if request.auth != null && request.auth.uid == resource.data.ownerId || request.resource.data.ownerId == request.auth.uid;
      // Prevent deletion to maintain audit trail (soft-delete recommended if needed)
      allow delete: if false;
    }
  }
}
