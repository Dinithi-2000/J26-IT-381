PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/cinnasense

# Module 02 secrets: generate each with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters; the server rejects writes while these are unset.
MODULE02_OPERATOR_TOKEN=
# JSON object mapping device ID -> its own secret, e.g. {"ESP32-S3-01":"<secret>"}
MODULE02_DEVICE_KEYS=

# Model 02 synthetic risk service: server-to-server only, never VITE_* variables.
MODULE02_RISK_SERVICE_URL=http://127.0.0.1:8000
# Match RISK_SERVICE_TOKEN in ml-service/.env; keep separate from all other tokens.
MODULE02_RISK_SERVICE_TOKEN=
# Bounded request timeout, integer 100..30000 milliseconds.
MODULE02_RISK_TIMEOUT_MS=10000
# New risk predictions require a stored reading no older than this (1..86400).
MODULE02_RISK_MAX_READING_AGE_SECONDS=300
# Optional local-only, dedicated database; name must end in module02_test.
# MODULE02_TEST_MONGODB_URI=mongodb://127.0.0.1:27017/cinnasense_module02_test
